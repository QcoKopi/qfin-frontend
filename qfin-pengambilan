<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pengambilan Stok Batch/LOT — Q.co Coffee Lab</title>
<!--
  qfin-pengambilan.html — v2026.08.21-2
  [F-PENGAMBILAN-R2] Keperluan Blending DIHAPUS dari form ini — blending
  Houseblend dicatat lewat form Assembly Entry di aplikasi utama (qfin.html)
  supaya stok RB otomatis berkurang & stok HB bertambah TANPA double entry.
  Keperluan di sini: Penjualan / Roasting / Sampling — semuanya CATATAN SAJA.
  Sisa tiap Batch/LOT tampil di daftar sumber + kotak info saat dipilih.
  [F-PENGAMBILAN] Form pengambilan stok per Batch/LOT — CATATAN SAJA
  (tidak mengurangi stok, tidak menyentuh GL). Terhubung ke backend GAS
  /exec yang sama dengan qfin.html (URL disimpan di localStorage
  'qfin_gas_url' — sama dengan aplikasi utama).
  Aturan (dijaga juga di backend Pengambilan.gs v2026.08.21-2):
  - Sumber: BATCH (sisa≠0, mesin FIFO sama dengan form Penjualan) atau
    LOT (pembelian persediaan dikurangi konsumsi assembly).
  - Jumlah tidak boleh melebihi sisa.
  - Roasting: hanya LOT produk green bean (id GB...).
  - Duplikat identik (tanggal+sumber+jumlah+keperluan+staff) ditolak.
-->
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f1ec; color: #2b2118; min-height: 100vh; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 18px 14px 60px; }
  header { background: linear-gradient(135deg, #3e2723, #6d4c41); color: #fff; border-radius: 12px; padding: 18px 20px; margin-bottom: 16px; }
  header h1 { font-size: 1.25rem; }
  header p { font-size: .82rem; opacity: .85; margin-top: 4px; }
  .card { background: #fff; border-radius: 12px; padding: 18px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .card h2 { font-size: 1rem; margin-bottom: 12px; color: #4e342e; }
  .form-group { margin-bottom: 12px; }
  label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 4px; }
  label .req { color: #c62828; }
  input, select, textarea { width: 100%; padding: 9px 10px; border: 1px solid #d7ccc8; border-radius: 8px; font-size: .92rem; background: #fff; }
  input:focus, select:focus, textarea:focus { outline: 2px solid #8d6e63; border-color: #8d6e63; }
  .hint { font-size: .78rem; color: #795548; margin-top: 4px; }
  .info-sisa { background: #efebe9; border-radius: 8px; padding: 8px 10px; font-size: .85rem; margin-top: 6px; display: none; }
  .btn { border: none; border-radius: 8px; padding: 11px 18px; font-size: .95rem; font-weight: 700; cursor: pointer; }
  .btn-primary { background: #4e342e; color: #fff; width: 100%; }
  .btn-primary:disabled { background: #a1887f; cursor: not-allowed; }
  .btn-secondary { background: #d7ccc8; color: #3e2723; }
  .alert { border-radius: 8px; padding: 10px 12px; font-size: .88rem; margin-bottom: 12px; display: none; white-space: pre-line; }
  .alert.success { display: block; background: #e8f5e9; color: #1b5e20; border: 1px solid #a5d6a7; }
  .alert.danger { display: block; background: #ffebee; color: #b71c1c; border: 1px solid #ef9a9a; }
  .alert.warning { display: block; background: #fff8e1; color: #8d6e00; border: 1px solid #ffe082; }
  .gasbar { display: flex; gap: 8px; }
  .gasbar input { flex: 1; font-size: .8rem; }
  table { width: 100%; border-collapse: collapse; font-size: .8rem; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #efebe9; }
  th { background: #efebe9; color: #4e342e; position: sticky; top: 0; }
  .badge { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: .72rem; font-weight: 700; }
  .badge.batch { background: #e3f2fd; color: #1565c0; }
  .badge.lot { background: #f3e5f5; color: #6a1b9a; }
  #loading { position: fixed; inset: 0; background: rgba(255,255,255,.75); display: none; align-items: center; justify-content: center; z-index: 99; }
  #loading .box { background: #3e2723; color: #fff; padding: 14px 22px; border-radius: 10px; font-weight: 700; }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  @media (max-width: 560px) { .row-2 { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<div id="loading"><div class="box">Memproses…</div></div>
<div class="wrap">
  <header>
    <h1>☕ Pengambilan Stok — Batch / LOT</h1>
    <p>Q.co Coffee Lab &amp; Roastery · <b>Catatan saja</b> — form ini TIDAK mengurangi stok &amp; tidak mengubah pembukuan.</p>
  </header>

  <div class="card">
    <div class="gasbar">
      <input type="text" id="gasUrl" placeholder="URL GAS /exec (otomatis terisi bila pernah disimpan di aplikasi utama)">
      <button class="btn btn-secondary" onclick="saveGasUrl()">Simpan URL</button>
    </div>
  </div>

  <div id="alertBox" class="alert"></div>

  <div class="card">
    <h2>Catat Pengambilan</h2>

    <div class="row-2">
      <div class="form-group">
        <label>Tanggal <span class="req">*</span></label>
        <input type="date" id="pgmTanggal">
      </div>
      <div class="form-group">
        <label>Keperluan <span class="req">*</span></label>
        <select id="pgmKeperluan" onchange="onKeperluanChange()">
          <option value="">— pilih —</option>
          <option value="Penjualan">Penjualan</option>
          <option value="Roasting">Roasting (khusus LOT green bean)</option>
          <option value="Sampling">Sampling</option>
        </select>
        <div class="hint">Blending / Houseblend <b>bukan</b> di sini — catat lewat
          <a href="qfin.html">form Assembly Entry di aplikasi utama</a> supaya stok RB berkurang &amp; stok HB bertambah otomatis (anti double entry).</div>
      </div>
    </div>

    <div class="form-group">
      <label>Sumber: Batch / LOT yang masih bersisa <span class="req">*</span></label>
      <input type="text" id="pgmCari" placeholder="Ketik untuk menyaring (kode / nama produk)…" oninput="renderSumberOptions()" style="margin-bottom:6px;">
      <select id="pgmSumber" size="7" onchange="onSumberChange()" style="font-family:Consolas,monospace;font-size:.85rem;"></select>
      <div class="hint" id="pgmSumberHint">Memuat daftar…</div>
      <div class="info-sisa" id="pgmInfoSisa"></div>
    </div>

    <div class="row-2">
      <div class="form-group">
        <label>Jumlah pengambilan <span class="req">*</span></label>
        <input type="number" id="pgmJumlah" min="0" step="0.001" placeholder="0.000">
        <div class="hint" id="pgmJumlahHint"></div>
      </div>
      <div class="form-group">
        <label>Nama Staff <span class="req">*</span></label>
        <select id="pgmStaff"><option value="">— memuat —</option></select>
      </div>
    </div>

    <div class="form-group">
      <label>Catatan (opsional)</label>
      <textarea id="pgmKeterangan" rows="2" placeholder="mis. untuk cupping buyer X"></textarea>
    </div>

    <button class="btn btn-primary" id="pgmBtnSubmit" onclick="submitPengambilan_()">SIMPAN CATATAN PENGAMBILAN</button>
  </div>

  <div class="card">
    <h2>10 Catatan Terakhir <button class="btn btn-secondary" style="float:right;padding:4px 10px;font-size:.75rem;" onclick="muatDaftar(true)">↻ Muat Ulang</button></h2>
    <div style="overflow-x:auto;">
      <table>
        <thead><tr><th>Tanggal</th><th>Sumber</th><th>Produk</th><th>Jumlah</th><th>Keperluan</th><th>Produk Jadi</th><th>Staff</th></tr></thead>
        <tbody id="pgmRecentBody"><tr><td colspan="7" style="text-align:center;color:#a1887f;">Belum ada data.</td></tr></tbody>
      </table>
    </div>
  </div>
</div>

<script>
'use strict';
// ===== Transport JSONP (pola sama dengan qfin.html) =====
let __pgmJsonpSeq = 0;

function getGasUrl() {
  return localStorage.getItem('qfin_gas_url') || document.getElementById('gasUrl').value || '';
}
function saveGasUrl() {
  const url = document.getElementById('gasUrl').value.trim();
  if (!url) { showAlert('warning', 'Paste dulu URL /exec dari deployment GAS.'); return; }
  localStorage.setItem('qfin_gas_url', url);
  showAlert('success', 'URL tersimpan. Memuat daftar…');
  muatDaftar(true);
}
function showLoading(on) { document.getElementById('loading').style.display = on ? 'flex' : 'none'; }
function showAlert(jenis, pesan) {
  const box = document.getElementById('alertBox');
  box.className = 'alert ' + jenis;
  box.textContent = pesan;
  if (jenis !== 'danger') setTimeout(() => { box.className = 'alert'; box.textContent = ''; }, 12000);
}
function escT(t) { return String(t == null ? '' : t).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

function callGAS(action, data, timeoutMs) {
  return new Promise((resolve) => {
    const url = getGasUrl();
    if (!url) { showAlert('danger', 'URL GAS kosong — paste URL /exec lalu klik Simpan URL.'); resolve({ success: false }); return; }
    showLoading(true);
    const callbackName = '__pgm_cb_' + Date.now() + '_' + (__pgmJsonpSeq++);
    const qs = new URLSearchParams();
    qs.set('action', action);
    qs.set('callback', callbackName);
    Object.keys(data || {}).forEach(k => {
      const v = data[k];
      if (v === undefined || v === null) return;
      qs.set(k, (typeof v === 'object') ? JSON.stringify(v) : String(v));
    });
    const script = document.createElement('script');
    let settled = false;
    const cleanup = () => {
      try { delete window[callbackName]; } catch (e) { window[callbackName] = undefined; }
      if (script.parentNode) script.parentNode.removeChild(script);
      clearTimeout(timeoutId);
    };
    const finish = (res) => { if (settled) return; settled = true; cleanup(); showLoading(false); resolve(res); };
    const timeoutId = setTimeout(() => {
      if (settled) return;
      settled = true; cleanup(); showLoading(false);
      // Aksi tulis: JANGAN auto-retry (risiko dobel) — suruh cek catatan terakhir.
      showAlert('danger', /^submit/i.test(action)
        ? 'GAS lambat merespons (cold start). PENTING: cek dulu "10 Catatan Terakhir" (klik Muat Ulang) sebelum simpan ulang, supaya tidak dobel.'
        : 'GAS lambat merespons — klik Muat Ulang dalam ±30 detik.');
      resolve({ success: false, message: 'timeout' });
    }, timeoutMs || 60000);
    window[callbackName] = function (res) { finish(res); };
    script.onerror = function () {
      if (settled) return;
      settled = true; cleanup(); showLoading(false);
      showAlert('danger', 'Tidak bisa menghubungi GAS — cek internet & pastikan URL /exec benar (akses "Anyone").');
      resolve({ success: false, message: 'network' });
    };
    script.src = url + (url.includes('?') ? '&' : '?') + qs.toString();
    document.head.appendChild(script);
  });
}

// ===== State =====
let pgmData = { batchlot: [], staff: [], recent: [] };
let pgmSumberDipilih = null; // {jenis, kode, id_produk, nama_produk, sisa, satuan}

// ===== Muat data form =====
async function muatDaftar(showErr) {
  document.getElementById('pgmSumberHint').textContent = 'Memuat daftar…';
  const res = await callGAS('getDaftarPengambilan', {}, 120000);
  if (!res || !res.success) {
    document.getElementById('pgmSumberHint').textContent = 'Gagal memuat.';
    if (showErr !== false) showAlert('danger', 'Gagal memuat daftar: ' + ((res && res.message) || 'tanpa pesan'));
    return;
  }
  pgmData.batchlot = res.batchlot || [];
  pgmData.staff = res.staff || [];
  pgmData.recent = res.recent || [];
  renderSumberOptions();
  renderStaff();
  renderRecent();
  document.getElementById('pgmSumberHint').textContent =
    pgmData.batchlot.length + ' sumber bersisa (klik salah satu baris). Sisa dihitung live saat ini.';
}

// ===== Dropdown sumber (BATCH + LOT) =====
function sumberTampil() {
  // Roasting: hanya LOT produk GB. Keperluan lain: semua.
  const kep = document.getElementById('pgmKeperluan').value;
  return pgmData.batchlot.filter(d => {
    if (kep === 'Roasting' && !(d.jenis === 'LOT' && /^GB/i.test(d.id_produk || ''))) return false;
    const q = (document.getElementById('pgmCari').value || '').trim().toLowerCase();
    if (q && !(d.kode + ' ' + d.nama_produk + ' ' + d.id_produk).toLowerCase().includes(q)) return false;
    return true;
  });
}
function renderSumberOptions() {
  const sel = document.getElementById('pgmSumber');
  const list = sumberTampil();
  sel.innerHTML = '';
  list.forEach(d => {
    const opt = document.createElement('option');
    opt.value = d.jenis + '|' + d.kode;
    opt.textContent = '[' + d.jenis + '] ' + d.kode + ' — ' + d.nama_produk + ' (sisa ' + d.sisa + ' ' + d.satuan + ')';
    if (pgmSumberDipilih && pgmSumberDipilih.jenis === d.jenis && pgmSumberDipilih.kode === d.kode) opt.selected = true;
    sel.appendChild(opt);
  });
  if (list.length === 0) {
    const opt = document.createElement('option');
    opt.value = '';
    opt.textContent = document.getElementById('pgmKeperluan').value === 'Roasting'
      ? '— tidak ada LOT green bean yang bersisa —'
      : '— tidak ada batch/LOT bersisa yang cocok —';
    sel.appendChild(opt);
  }
  // Kalau pilihan lama tidak ada lagi di daftar (mis. ganti ke Roasting), kosongkan.
  if (pgmSumberDipilih && !list.some(d => d.jenis === pgmSumberDipilih.jenis && d.kode === pgmSumberDipilih.kode)) {
    pgmSumberDipilih = null;
    document.getElementById('pgmInfoSisa').style.display = 'none';
  }
}
function onSumberChange() {
  const val = document.getElementById('pgmSumber').value;
  const info = document.getElementById('pgmInfoSisa');
  if (!val) { pgmSumberDipilih = null; info.style.display = 'none'; return; }
  const p = val.split('|');
  const jenis = p[0], kode = p.slice(1).join('|');
  pgmSumberDipilih = pgmData.batchlot.find(d => d.jenis === jenis && d.kode === kode) || null;
  if (pgmSumberDipilih) {
    info.style.display = 'block';
    info.innerHTML = 'Produk asal: <b>' + escT(pgmSumberDipilih.nama_produk) + '</b> (' + escT(pgmSumberDipilih.id_produk || '-') + ') · Sisa: <b>' +
      pgmSumberDipilih.sisa + ' ' + escT(pgmSumberDipilih.satuan) + '</b>' +
      (pgmSumberDipilih.tanggal ? ' · Tanggal: ' + escT(pgmSumberDipilih.tanggal) : '');
    document.getElementById('pgmJumlahHint').textContent = 'Maksimal ' + pgmSumberDipilih.sisa + ' ' + pgmSumberDipilih.satuan + '.';
    document.getElementById('pgmJumlah').max = pgmSumberDipilih.sisa;
  } else {
    info.style.display = 'none';
  }
}
function onKeperluanChange() {
  const kep = document.getElementById('pgmKeperluan').value;
  renderSumberOptions();
  if (kep === 'Roasting') {
    const ada = pgmData.batchlot.some(d => d.jenis === 'LOT' && /^GB/i.test(d.id_produk || ''));
    if (!ada) showAlert('warning', 'Tidak ada LOT green bean (GB) yang masih bersisa untuk Roasting.');
  }
}

// ===== Dropdown staff & produk jadi =====
function renderStaff() {
  const sel = document.getElementById('pgmStaff');
  const cur = sel.value;
  sel.innerHTML = '<option value="">— pilih staff —</option>';
  pgmData.staff.forEach(s => {
    const opt = document.createElement('option');
    opt.value = s.nama_salesman;
    opt.textContent = s.nama_salesman;
    sel.appendChild(opt);
  });
  if (cur && pgmData.staff.some(s => s.nama_salesman === cur)) sel.value = cur;
}
// ===== Recent =====
function renderRecent() {
  const body = document.getElementById('pgmRecentBody');
  if (!pgmData.recent.length) {
    body.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#a1887f;">Belum ada data.</td></tr>';
    return;
  }
  body.innerHTML = pgmData.recent.map(r =>
    '<tr><td>' + escT(r.tanggal) + '</td>' +
    '<td><span class="badge ' + (r.jenis === 'LOT' ? 'lot' : 'batch') + '">' + escT(r.jenis) + '</span> ' + escT(r.referensi) + '</td>' +
    '<td>' + escT(r.nama_produk_asal) + '</td>' +
    '<td>' + escT(r.jumlah) + ' ' + escT(r.satuan) + '</td>' +
    '<td>' + escT(r.keperluan) + '</td>' +
    '<td>' + escT(r.nama_produk_jadi || '—') + '</td>' +
    '<td>' + escT(r.nama_staff) + '</td></tr>'
  ).join('');
}

// ===== Submit =====
async function submitPengambilan_() {
  const tgl = document.getElementById('pgmTanggal').value;
  if (!tgl) { showAlert('danger', 'Tanggal wajib diisi.'); return; }
  const kep = document.getElementById('pgmKeperluan').value;
  if (!kep) { showAlert('danger', 'Keperluan wajib dipilih.'); return; }
  if (!pgmSumberDipilih) { showAlert('danger', 'Pilih dulu Batch/LOT sumber dari daftar.'); return; }
  const jmlRaw = (document.getElementById('pgmJumlah').value || '').trim();
  if (jmlRaw === '' || isNaN(Number(jmlRaw))) { showAlert('danger', 'Jumlah pengambilan wajib diisi angka.'); return; }
  const jumlah = Number(jmlRaw);
  if (jumlah <= 0) { showAlert('danger', 'Jumlah pengambilan harus lebih dari 0.'); return; }
  if (jumlah > pgmSumberDipilih.sisa + 1e-9) {
    showAlert('danger', 'Jumlah ' + jumlah + ' melebihi sisa ' + pgmSumberDipilih.sisa + ' ' + pgmSumberDipilih.satuan + ' pada ' + pgmSumberDipilih.kode + '.');
    return;
  }
  const staff = document.getElementById('pgmStaff').value;
  if (!staff) { showAlert('danger', 'Nama staff wajib dipilih.'); return; }
  if (kep === 'Roasting' && !(pgmSumberDipilih.jenis === 'LOT' && /^GB/i.test(pgmSumberDipilih.id_produk || ''))) {
    showAlert('danger', 'Roasting hanya boleh dari LOT green bean (GB).'); return;
  }
  const ringkas = tgl + ' · ' + pgmSumberDipilih.jenis + ' ' + pgmSumberDipilih.kode +
    ' · ' + jumlah + ' ' + pgmSumberDipilih.satuan + ' · ' + kep + ' · ' + staff;
  if (!confirm('Simpan catatan pengambilan ini?\n\n' + ringkas + '\n\n(Stok TIDAK berkurang — ini catatan saja.)')) return;

  document.getElementById('pgmBtnSubmit').disabled = true;
  try {
    const res = await callGAS('submitPengambilan', {
      tanggal: tgl, jenis: pgmSumberDipilih.jenis, referensi: pgmSumberDipilih.kode,
      jumlah: jumlah, keperluan: kep,
      nama_staff: staff, keterangan: document.getElementById('pgmKeterangan').value.trim()
    }, 120000);
    if (res && res.success) {
      showAlert('success', res.message || 'Tercatat.');
      document.getElementById('pgmJumlah').value = '';
      document.getElementById('pgmKeterangan').value = '';
      muatDaftar(false);
    } else {
      showAlert('danger', 'Gagal: ' + ((res && res.message) || 'tanpa pesan'));
    }
  } finally {
    document.getElementById('pgmBtnSubmit').disabled = false;
  }
}

// ===== Init =====
(function init() {
  const saved = localStorage.getItem('qfin_gas_url');
  if (saved) document.getElementById('gasUrl').value = saved;
  document.getElementById('pgmTanggal').value = new Date().toISOString().slice(0, 10);
  if (getGasUrl()) muatDaftar(false);
  else document.getElementById('pgmSumberHint').textContent = 'Isi URL GAS dulu di atas.';
})();
</script>
</body>
</html>
